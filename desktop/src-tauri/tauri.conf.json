{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rashevsky",
  "mainBinaryName": "rashevsky-desktop",
  "version": "0.1.0",
  "identifier": "com.flintglade.rashevsky",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rashevsky",
        "width": 1560,
        "height": 980,
        "minWidth": 1080,
        "minHeight": 680,
        "backgroundColor": "#14171a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png",
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "Genome-scale and kinetic metabolic modelling",
    "longDescription": "Flux balance, knockout screens, flux sampling, thermodynamics, kinetic simulation and metabolic control analysis on SBML models.",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../../models/teusink/NOTICE": "NOTICE-teusink.txt",
      "../../data/thermo/NOTICE": "NOTICE-thermo.txt",
      "../../data/biochemistry/NOTICE": "NOTICE-biochemistry.txt",
      "../../models/ich360/NOTICE": "NOTICE-iCH360.txt"
    }
  }
}
